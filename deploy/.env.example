# ============================================================
# Location Tracker — environment file (copy to .env on the server)
# All values are read by location_server/settings.py + install.sh
# ============================================================

# --- Django core ---
# Generate a strong one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# (The installer auto-generates one if this placeholder is left as-is.)
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=False
# Comma-separated list. Include both the new vanity subdomain AND the
# legacy duckdns hostname so both vhosts work during the migration window.
DJANGO_ALLOWED_HOSTS=tracker.example.com,localhost,127.0.0.1
# Comma-separated. Used for CSRF on form POSTs (admin, register, etc.).
# Include :8443 for the legacy host and the bare https URL for the new one.
DJANGO_CSRF_TRUSTED_ORIGINS=https://tracker.example.com,https://tracker.example.com:443,https://tracker.example.com:8443

# --- Admin panel protection (same pattern as CodeMill) ---
# Non-obvious URL path (no slashes).
DJANGO_ADMIN_URL=staff-control
# Comma-separated list of IPs allowed to reach the admin panel.
# Leave blank to disable IP allowlist (basic auth still protects it).
# Find your IP at https://ifconfig.me
ADMIN_ALLOWED_IPS=
# Basic auth backstop (works regardless of IP).
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASS=change-this-to-a-strong-password

# --- Admin / error emails ---
ADMIN_NAME=Owner
ADMIN_EMAIL=you@thecodemill.dev

# --- Tracker-specific config ---
# Host + port baked into QR codes at device registration time.
# During the migration window these should stay pointing at the LEGACY
# hostname:port that existing APKs already trust. Flip to the new
# vanity domain only after shipping an APK upgrade that switches the
# app's defaults.
TRACKER_SERVER_HOST=tracker.example.com
TRACKER_SERVER_PORT=8443
# Optional SHA-256 pin of the self-signed cert (sha256/base64=...).
# Leave blank when using a public CA (Let's Encrypt).
TRACKER_CERT_PIN_HASH=

# Path to the Google Geolocation API key file (wardriving fallback).
# If unset, defaults to <app_dir>/google_api_key.
# GOOGLE_GEOLOCATION_API_KEY_FILE=/opt/location-tracker/google_api_key

# CVE-search API base URL. Defaults to the local Docker container.
# CVE_API_BASE=http://127.0.0.1:5000

# --- Deploy target (used by local deploy.sh + backup.sh) ---
# DEPLOY_USER=root
# DEPLOY_HOST=tracker.example.com
